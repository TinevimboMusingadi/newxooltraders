{
  "rewrites": [
    { "source": "/auth/:path*", "destination": "https://YOUR_BACKEND_URL/auth/:path*" },
    { "source": "/api/:path*", "destination": "https://YOUR_BACKEND_URL/api/:path*" },
    { "source": "/health", "destination": "https://YOUR_BACKEND_URL/health" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
