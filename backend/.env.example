# Deriv OAuth — Web-based app at developers.deriv.com → Registered apps → Web-based apps
# 1. Redirect URL: http://localhost:5173/auth/callback
# 2. Scopes: Trade + Account management
# 3. Copy values below after Create application
DERIV_APP_ID=
DERIV_CLIENT_ID=
# Optional — new Deriv Web-based OAuth uses PKCE; App ID is usually the client_id
DERIV_CLIENT_SECRET=
DERIV_REDIRECT_URI=http://localhost:5173/auth/callback

# Affiliate (Partner dashboard — optional for MVP)
AFFILIATE_UTM_SOURCE=
AFFILIATE_UTM_CAMPAIGN=
AFFILIATE_SIDC=

PORT=4000
NODE_ENV=development
SESSION_SECRET=change-me-to-a-long-random-string
FRONTEND_URL=http://localhost:5173
DATABASE_URL=

# PAT — create under the SAME Web-based app (API tokens tab), scopes: Trade + Account management
DERIV_PAT_TOKEN=
